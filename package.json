{
  "name": "dunfinity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A procedural roguelike dungeon crawler for the browser.",
  "scripts": {
    "dev": "node tools/actors/pack.mjs && vite",
    "build": "node tools/actors/pack.mjs && tsc --noEmit && vite build",
    "build:publish": "node tools/actors/pack.mjs && tsc --noEmit && vite build --mode publish",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"tools/**/*.test.mjs\"",
    "dup": "node tools/duplicate-candidates/find-duplicate-candidates.mjs",
    "repeated": "node tools/repeated-code/find-repeated-code.mjs",
    "shot": "node tools/shot/shot.mjs",
    "strip": "node --import tsx tools/shot/strip.mjs",
    "check:shaders": "node tools/shot/shader-check.mjs",
    "props": "node tools/props/pack.mjs",
    "actors:pack": "node tools/actors/pack.mjs"
  },
  "dependencies": {
    "@actors/core": "https://github.com/ArndRosemeier/Actors/releases/download/v0.3.0/actors-core-0.3.0.tgz",
    "@actors/generator": "https://github.com/ArndRosemeier/Actors/releases/download/v0.3.0/actors-generator-0.3.0.tgz",
    "@actors/human": "https://github.com/ArndRosemeier/Actors/releases/download/v0.3.0/actors-human-0.3.0.tgz",
    "@actors/three": "https://github.com/ArndRosemeier/Actors/releases/download/v0.3.0/actors-three-0.3.0.tgz",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@futuremagic/core": "file:vendor/assetgenerator/packages/core",
    "@futuremagic/humanoid": "file:vendor/assetgenerator/packages/humanoid",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
